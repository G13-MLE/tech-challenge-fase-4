# =============================================================================
# Ambiente
# =============================================================================
# Ambiente de execução: development | production
APP_ENV=development

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# =============================================================================
# Dados e modelo
# =============================================================================
# Fonte do dataset de referência: uci (real, ~30k) | synthetic (fallback offline/CI)
DATASET_SOURCE=uci

# Caminho do dataset de referência (treino)
REFERENCE_DATA_PATH=data/reference/reference.parquet

# Diretório dos snapshots de produção (onde o drift ocorre)
PRODUCTION_DATA_DIR=data/production

# Caminho do artefato de modelo treinado
MODEL_PATH=models/model.joblib

# =============================================================================
# MLflow (tracking de experimentos e ciclo de vida do modelo)
# =============================================================================
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://localhost:5001

# =============================================================================
# Dashboard (Streamlit)
# =============================================================================
DASHBOARD_PORT=8501

# =============================================================================
# Monitoramento (opcional — Prometheus + Grafana)
# =============================================================================
# Porta do Prometheus
PROMETHEUS_PORT=9090
# Porta do Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
# Porta do exporter /metrics (prometheus-client, serviço dedicado)
PROMETHEUS_EXPORTER_PORT=8000

# =============================================================================
# Limiares de drift (métricas de decisão)
# =============================================================================
# PSI: < stable = estável; stable..moderate = moderado; > moderate = severo
DRIFT_PSI_STABLE=0.1
DRIFT_PSI_MODERATE=0.25

# Queda de ROC-AUC que dispara alerta de degradação
DRIFT_AUC_DROP_ALERT=0.05

# =============================================================================
# Kaggle (opcional — download do dataset)
# =============================================================================
# Crie em https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# =============================================================================
# DVC
# =============================================================================
# Remote DVC (OneDrive) — OPCIONAL. Deixe vazio para ambiente self-contained.
# O pipeline roda normalmente sem remote; ele só é necessário para
# compartilhar dados/modelos entre máquinas. Para configurar, preencha a URL
# e rode `make dvc-remote` (ou `make setup`).
DVC_ONEDRIVE_REMOTE_URL=
